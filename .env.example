# Database
DATABASE_URL="mysql://root:password@localhost:3306/nexacore_cotizador"

# Auth
NEXTAUTH_SECRET="generate-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Usuario administrador creado/actualizado por el seed en cada arranque.
# Cambiar ADMIN_PASSWORD y redesplegar rota la contraseña.
ADMIN_NAME="Admin NexaCore"
ADMIN_EMAIL="admin@nexacore.com.mx"
ADMIN_PASSWORD="cambiar-esta-contrasena"

# SMTP (email sending)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="cotizaciones@nexacore.com"

# Cloudflare R2 (almacenamiento de CFDI). Si se dejan vacías, se puede capturar
# el UUID pero no adjuntar/descargar archivos. El endpoint se arma con el
# account id: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="nexacore-cotizador-cfdi"

# Docker compose only
MYSQL_ROOT_PASSWORD="password"
MYSQL_DATABASE="nexacore_cotizador"

# Puerto del host donde se publica la app. Cámbialo si ya está ocupado por otro
# servicio; dentro del contenedor siempre es el 3000.
APP_PORT="3033"
