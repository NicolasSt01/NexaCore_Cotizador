generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         String      @default("editor")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  quotations   Quotation[]
  quotationLogs QuotationLog[]

  @@map("users")
}

model Client {
  id            Int         @id @default(autoincrement())
  businessName  String      @map("business_name")
  rfc           String      @unique
  curp          String?
  email         String?
  phone         String?
  addressStreet String?     @map("address_street")
  addressNumber String?     @map("address_number")
  addressColony String?     @map("address_colony")
  city          String?
  state         String?
  zipCode       String?     @map("zip_code")
  taxRegime     String?     @map("tax_regime")
  cfdiUsage     String?     @map("cfdi_usage")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  quotations    Quotation[]
  contracts     Contract[]

  @@map("clients")
}

model Product {
  id          Int                @id @default(autoincrement())
  name        String
  description String?
  unitPrice   Decimal            @db.Decimal(12, 2) @map("unit_price")
  taxType     String             @default("iva") @map("tax_type")
  unit        String             @default("pieza")
  sku         String             @unique
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")
  items       QuotationItem[]

  @@map("products")
}

model Quotation {
  id              Int              @id @default(autoincrement())
  folio           String           @unique
  clientId        Int              @map("client_id")
  userId          Int              @map("user_id")
  status          String           @default("borrador")
  issueDate       DateTime         @default(now()) @map("issue_date")
  validUntil      DateTime?        @map("valid_until")
  paymentTerms    String?          @db.Text @map("payment_terms")
  deliveryTerms   String?          @db.Text @map("delivery_terms")
  notes           String?          @db.Text
  termsConditions String?          @db.Text @map("terms_conditions")
  subtotal        Decimal          @default(0) @db.Decimal(14, 2)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2) @map("discount_percent")
  discountAmount  Decimal          @default(0) @db.Decimal(14, 2) @map("discount_amount")
  ivaAmount       Decimal          @default(0) @db.Decimal(14, 2) @map("iva_amount")
  isrRetencion    Decimal          @default(0) @db.Decimal(14, 2) @map("isr_retencion")
  ivaRetencion    Decimal          @default(0) @db.Decimal(14, 2) @map("iva_retencion")
  total           Decimal          @default(0) @db.Decimal(14, 2)

  // Las retenciones solo aplican cuando una persona física factura a una moral,
  // por eso van apagadas salvo que se activen explícitamente en la cotización.
  applyIsrRetencion Boolean        @default(false) @map("apply_isr_retencion")
  applyIvaRetencion Boolean        @default(false) @map("apply_iva_retencion")

  // Qué renglones del desglose se imprimen en el PDF.
  pdfShowSubtotal    Boolean       @default(true) @map("pdf_show_subtotal")
  pdfShowDiscount    Boolean       @default(true) @map("pdf_show_discount")
  pdfShowIva         Boolean       @default(true) @map("pdf_show_iva")
  pdfShowRetenciones Boolean       @default(true) @map("pdf_show_retenciones")

  publicHash      String?          @unique @map("public_hash")
  currency        String           @default("MXN")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  client          Client           @relation(fields: [clientId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  items           QuotationItem[]
  invoice         Invoice?
  logs            QuotationLog[]

  @@map("quotations")
}

model QuotationItem {
  id              Int        @id @default(autoincrement())
  quotationId     Int        @map("quotation_id")
  productId       Int?       @map("product_id")
  concept         String
  description     String?
  quantity        Int
  unit            String     @default("pieza")
  unitPrice       Decimal    @db.Decimal(12, 2) @map("unit_price")
  discountPercent Decimal    @default(0) @db.Decimal(5, 2) @map("discount_percent")
  subtotal        Decimal    @db.Decimal(14, 2)
  iva             Decimal    @default(0) @db.Decimal(14, 2)
  total           Decimal    @db.Decimal(14, 2)
  sortOrder       Int        @default(0) @map("sort_order")
  quotation       Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product?   @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

model Invoice {
  id            Int        @id @default(autoincrement())
  // Una factura nace de una cotización (venta única) o de un cargo mensual de un
  // contrato recurrente. Por eso ambos son opcionales y excluyentes.
  quotationId   Int?       @unique @map("quotation_id")
  chargeId      Int?       @unique @map("charge_id")
  folio         String     @unique
  // Ciclo: solicitada (al despacho) → facturada (timbrada por el despacho) →
  // pagada. "vencida" no se guarda: se deriva de dueDate.
  status        String     @default("solicitada")
  subtotal      Decimal    @db.Decimal(14, 2)
  iva           Decimal    @db.Decimal(14, 2)
  retenciones   Decimal    @db.Decimal(14, 2)
  total         Decimal    @db.Decimal(14, 2)
  dueDate       DateTime?  @map("due_date")
  issueDate     DateTime   @default(now()) @map("issue_date")
  paymentDate   DateTime?  @map("payment_date")
  pdfPath       String?    @map("pdf_path")

  // Datos que el despacho necesita para timbrar (forma/método de pago SAT) y el
  // resultado del timbrado (folio fiscal/UUID + fecha).
  formaPago     String?    @map("forma_pago")
  metodoPago    String?    @map("metodo_pago")
  uuid          String?    @map("uuid")
  invoicedAt    DateTime?  @map("invoiced_at")

  // Llaves del CFDI en R2 (el archivo vive en el bucket, no en la BD).
  cfdiPdfKey    String?    @map("cfdi_pdf_key")
  cfdiXmlKey    String?    @map("cfdi_xml_key")

  createdAt     DateTime   @default(now()) @map("created_at")
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  charge        Charge?    @relation(fields: [chargeId], references: [id])

  @@map("invoices")
}

/**
 * Contrato recurrente con un cliente (una plataforma/servicio que le damos).
 * Agrupa conceptos que se cobran cada mes: fijos y/o por uso.
 */
model Contract {
  id          Int            @id @default(autoincrement())
  clientId    Int            @map("client_id")
  name        String
  status      String         @default("activo") // activo | pausado | cancelado
  billingDay  Int            @default(1) @map("billing_day")
  currency    String         @default("MXN")
  notes       String?
  startDate   DateTime       @default(now()) @map("start_date")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  client      Client         @relation(fields: [clientId], references: [id])
  items       ContractItem[]
  charges     Charge[]

  @@map("contracts")
}

model ContractItem {
  id          Int      @id @default(autoincrement())
  contractId  Int      @map("contract_id")
  concept     String
  kind        String   @default("fijo") // fijo | uso
  // fijo: monto mensual; uso: precio por unidad (se multiplica por el uso del mes).
  unitPrice   Decimal  @db.Decimal(12, 2) @map("unit_price")
  unit        String   @default("mes")
  taxType     String   @default("iva") // iva | exento
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_items")
}

/**
 * Cargo del periodo (corte mensual) de un contrato. Se genera como "borrador"
 * para revisar el uso, y luego se convierte en factura.
 */
model Charge {
  id          Int          @id @default(autoincrement())
  contractId  Int          @map("contract_id")
  periodYear  Int          @map("period_year")
  periodMonth Int          @map("period_month")
  status      String       @default("borrador") // borrador | facturado | cancelado
  subtotal    Decimal      @default(0) @db.Decimal(14, 2)
  iva         Decimal      @default(0) @db.Decimal(14, 2)
  total       Decimal      @default(0) @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  contract    Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lines       ChargeLine[]
  invoice     Invoice?

  @@unique([contractId, periodYear, periodMonth])
  @@map("charges")
}

model ChargeLine {
  id        Int      @id @default(autoincrement())
  chargeId  Int      @map("charge_id")
  concept   String
  kind      String   @default("fijo") // fijo | uso
  quantity  Decimal  @default(1) @db.Decimal(12, 2) // uso: unidades del mes; fijo: 1
  unitPrice Decimal  @db.Decimal(12, 2) @map("unit_price")
  unit      String   @default("")
  taxType   String   @default("iva")
  subtotal  Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")
  charge    Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@map("charge_lines")
}

model CompanySettings {
  id                Int      @id @default(autoincrement())
  businessName      String   @map("business_name")
  rfc               String
  curp              String?
  taxRegime         String?  @map("tax_regime")
  addressStreet     String?  @map("address_street")
  addressNumber     String?  @map("address_number")
  addressColony     String?  @map("address_colony")
  city              String?
  state             String?
  zipCode           String?  @map("zip_code")
  logoPath          String?  @map("logo_path")

  // El logo se guarda como data URI ("data:image/png;base64,...") en vez de como
  // archivo: html2canvas contamina el canvas al rasterizar imágenes de otro
  // origen y el PDF fallaría, y el contenedor de Dokploy no tiene volumen
  // persistente donde sobreviviría un archivo subido.
  logoData          String?  @db.LongText @map("logo_data")
  /** Alto en px con el que se imprime el logo en el PDF. */
  logoHeight        Int      @default(48) @map("logo_height")

  /**
   * Nombre corto de marca para el logotipo del PDF ("NexaCore"), distinto de la
   * razón social fiscal. Vacío = no se imprime el logotipo de texto.
   */
  brandName         String?  @map("brand_name")

  email             String?
  phone             String?
  website           String?
  ivaRate           Decimal  @default(0.16) @db.Decimal(5, 4) @map("iva_rate")
  isrRetencionRate  Decimal  @default(0.10) @db.Decimal(5, 4) @map("isr_retencion_rate")
  ivaRetencionRate  Decimal  @default(0.106666) @db.Decimal(8, 6) @map("iva_retencion_rate")
  defaultTerms      String?  @db.Text @map("default_terms")
  defaultNotes      String?  @db.Text @map("default_notes")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

/** Registro de auditoría de cambios de estado de una cotización. */
model QuotationLog {
  id          Int        @id @default(autoincrement())
  quotationId Int        @map("quotation_id")
  userId      Int?       @map("user_id")
  fromStatus  String?    @map("from_status")
  toStatus    String     @map("to_status")
  note        String?
  createdAt   DateTime   @default(now()) @map("created_at")
  quotation   Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id])

  @@map("quotation_logs")
}